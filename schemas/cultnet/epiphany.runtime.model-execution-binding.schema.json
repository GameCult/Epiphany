{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://gamecult.dev/epiphany/cultnet/epiphany.runtime.model-execution-binding.schema.json",
  "title": "Epiphany Runtime Model Execution Binding",
  "description": "Immutable ownership edge from one native/provider model request pair to its runtime session and job.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schemaVersion": { "type": "string", "const": "epiphany.runtime.model_execution_binding.v0" },
    "bindingId": { "type": "string", "minLength": 1 },
    "requestId": { "type": "string", "minLength": 1 },
    "sessionId": { "type": "string", "minLength": 1 },
    "jobId": { "type": "string", "minLength": 1 },
    "provider": { "type": "string", "minLength": 1 },
    "boundAt": { "type": "string", "format": "date-time" },
    "sourceWorkerJobId": { "type": ["string", "null"] }
  },
  "required": [
    "schemaVersion",
    "bindingId",
    "requestId",
    "sessionId",
    "jobId",
    "provider",
    "boundAt"
  ]
}
