  "properties": {
    "repos": {
      "items": {
        "$ref": "#/$defs/Short"
      },
      "type": "array"
    },
    "slug": {
      "$ref": "#/$defs/Short"
    },
    "target_doc": {
      "$ref": "#/$defs/DocRef"
    },
    "title": {
      "$ref": "#/$defs/Short"
    },
    "working_branch": {
      "$ref": "#/$defs/Short"
    }
  },
  "required": [
    "slug",
    "title",
    "repos",
    "working_branch",
    "target_doc"
  ],
  "title": "PipelineCampaign",
  "type": "object"
}
