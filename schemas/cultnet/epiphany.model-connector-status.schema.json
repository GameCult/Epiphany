{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://gamecult.dev/epiphany/cultnet/epiphany.model-connector-status.schema.json",
  "title": "Epiphany Model Connector Status",
  "type": "object",
  "required": [
    "schema_id",
    "provider_id",
    "capability_id",
    "request_schema_id",
    "result_schema_id",
    "envelope_schema_id",
    "transport_protocol",
    "host",
    "port",
    "max_payload_bytes",
    "max_parallel_requests",
    "model",
    "ready",
    "updated_at_utc"
  ],
  "properties": {
    "schema_id": { "const": "epiphany.model_connector_status.v1" },
    "provider_id": { "const": "epiphany.codex-model" },
    "capability_id": { "const": "model.generate.structured" },
    "request_schema_id": { "const": "epiphany.model_connector_invocation.v1" },
    "result_schema_id": { "const": "epiphany.model_connector_result.v1" },
    "envelope_schema_id": { "const": "epiphany.model_connector_envelope.v1" },
    "transport_protocol": { "const": "cultnet.tcp_framed.v0" },
    "host": { "type": "string", "minLength": 1 },
    "port": { "type": "integer", "minimum": 1, "maximum": 65535 },
    "max_payload_bytes": { "type": "integer", "minimum": 4096 },
    "max_parallel_requests": { "type": "integer", "minimum": 1 },
    "model": { "type": "string", "minLength": 1 },
    "ready": { "type": "boolean" },
    "updated_at_utc": { "type": "string", "format": "date-time" }
  },
  "additionalProperties": false
}
