{
  "$defs": {
    "ClaimOutcome": {
      "enum": [
        "Holds",
        "Falsified",
        "Unproven"
      ],
      "type": "string"
    },
    "CommitRange": {
      "properties": {
        "base": {
          "$ref": "#/$defs/Sha"
        },
        "head": {
          "$ref": "#/$defs/Sha"
        }
      },
      "required": [
        "base",
        "head"
      ],
      "type": "object"
    },
    "Evidence": {
      "properties": {
        "kind": {
          "$ref": "#/$defs/EvidenceKind"
        },
        "locator": {
          "$ref": "#/$defs/Line"
        },
        "result": {
          "$ref": "#/$defs/Line"
        }
      },
      "required": [
        "kind",
        "locator",
        "result"
      ],
      "type": "object"
    },
    "EvidenceKind": {
      "enum": [
        "Command",
        "Test",
        "Mutation",
        "Probe",
        "SourceRead",
        "Capture"
      ],
      "type": "string"
    },
    "Line": {
      "description": "Text of at most 1,000 UTF-8 bytes.",
      "maxLength": 1000,
      "type": "string"
    },
    "Sha": {
      "description": "A git commit id: 7-40 lowercase hex characters.",
      "maxLength": 40,
      "type": "string"
    },
    "Short": {
      "description": "Text of at most 200 UTF-8 bytes.",
      "maxLength": 200,
      "type": "string"
    },
    "Slug": {
      "description": "A campaign slug or key segment: label parts joined by `.`.",
      "maxLength": 64,
      "type": "string"
    },
    "VerdictClaim": {
      "properties": {
        "claim": {
          "$ref": "#/$defs/Line"
        },
        "evidence": {
          "items": {
            "$ref": "#/$defs/Evidence"
          },
          "maxItems": 8,
          "type": "array"
        },
        "findings": {
          "items": {
            "$ref": "#/$defs/Short"
          },
          "maxItems": 16,
          "type": "array"
        },
        "outcome": {
          "$ref": "#/$defs/ClaimOutcome"
        }
      },
      "required": [
        "claim",
        "outcome",
        "evidence",
        "findings"
      ],
      "type": "object"
    }
  },
  "$id": "https://gamecult.dev/epiphany/cultnet/epiphany.pipeline.verdict.v1.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
    "campaign": {
      "$ref": "#/$defs/Slug"
    },
    "claims": {
      "items": {
        "$ref": "#/$defs/VerdictClaim"
      },
      "maxItems": 64,
      "type": "array"
    },
    "cut_report": {
      "$ref": "#/$defs/Short"
    },
    "pass": {
      "format": "uint32",
      "minimum": 0,
      "type": "integer"
    },
    "range": {
      "$ref": "#/$defs/CommitRange"
    }
  },
  "required": [
    "campaign",
    "cut_report",
    "pass",
    "range",
    "claims"
  ],
  "title": "PipelineVerdict",
  "type": "object"
}
