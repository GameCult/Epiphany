{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://gamecult.dev/epiphany/cultnet/epiphany.runtime.tool-execution-binding.schema.json",
  "title": "Epiphany Runtime Tool Execution Binding",
  "description": "Immutable ownership edge from one tool intent to its runtime session, job, and optional model execution.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schemaVersion": { "type": "string", "const": "epiphany.runtime.tool_execution_binding.v0" },
    "bindingId": { "type": "string", "minLength": 1 },
    "intentId": { "type": "string", "minLength": 1 },
    "sessionId": { "type": "string", "minLength": 1 },
    "jobId": { "type": "string", "minLength": 1 },
    "modelRequestId": { "type": ["string", "null"] },
    "boundAt": { "type": "string", "format": "date-time" }
  },
  "required": [
    "schemaVersion",
    "bindingId",
    "intentId",
    "sessionId",
    "jobId",
    "boundAt"
  ]
}
