{
  "$defs": {
    "DocRef": {
      "properties": {
        "commit": {
          "$ref": "#/$defs/Sha"
        },
        "end_line": {
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "path": {
          "$ref": "#/$defs/Short"
        },
        "start_line": {
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "path",
        "start_line",
        "end_line",
        "commit"
      ],
      "type": "object"
    },
    "OrgRepo": {
      "description": "A GitHub repository as `Org/Repo`.",
      "maxLength": 200,
      "type": "string"
    },
    "Sha": {
      "description": "A git commit id: 7-40 lowercase hex characters.",
      "maxLength": 40,
      "type": "string"
    },
    "Short": {
      "description": "Text of at most 200 UTF-8 bytes.",
      "maxLength": 200,
      "type": "string"
    },
    "Slug": {
      "description": "A campaign slug or key segment: label parts joined by `.`.",
      "maxLength": 64,
      "type": "string"
    },
    "Title": {
      "description": "A title: 1 to 200 UTF-8 bytes, never empty. All four leaf titles\n(campaign, cut spec, question and ruling) carry this type, ruled B\nunder Q-RS1: the epoch moves in this cut regardless, so tightening the\ntwo titles that were `Short` costs nothing extra and avoids a second\nepoch bump later just to make a title required.",
      "maxLength": 200,
      "type": "string"
    }
  },
  "$id": "https://gamecult.dev/epiphany/cultnet/epiphany.pipeline.campaign.v2.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
    "repos": {
      "items": {
        "$ref": "#/$defs/OrgRepo"
      },
      "maxItems": 8,
      "type": "array"
    },
    "slug": {
      "$ref": "#/$defs/Slug"
    },
    "target_doc": {
      "$ref": "#/$defs/DocRef"
    },
    "title": {
      "$ref": "#/$defs/Title"
    },
    "working_branch": {
      "$ref": "#/$defs/Short"
    }
  },
  "required": [
    "slug",
    "title",
    "repos",
    "working_branch",
    "target_doc"
  ],
  "title": "PipelineCampaign",
  "type": "object"
}
