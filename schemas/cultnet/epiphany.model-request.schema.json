{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://gamecult.dev/epiphany/cultnet/epiphany.model-request.schema.json",
  "title": "Epiphany Model Request",
  "type": "object",
  "required": ["schema_id", "request_id", "conversation_id", "provider", "model", "instructions", "input"],
  "properties": {
    "schema_id": { "const": "epiphany.model_request.v0" },
    "request_id": { "type": "string" },
    "conversation_id": { "type": "string" },
    "provider": { "type": "string" },
    "model": { "type": "string" },
    "instructions": { "type": "string" },
    "input": {
      "type": "array",
      "items": { "$ref": "#/$defs/input_item" }
    },
    "reasoning_effort": { "type": ["string", "null"] },
    "reasoning_summary": { "type": ["string", "null"] },
    "service_tier": { "type": ["string", "null"] },
    "output_contract_id": { "type": ["string", "null"] },
    "previous_response_id": { "type": ["string", "null"] },
    "tools": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "description", "parameters_json"],
        "properties": {
          "name": { "type": "string" },
          "description": { "type": "string" },
          "parameters_json": { "type": "string" }
        },
        "additionalProperties": false
      }
    },
    "output_schema_json": { "type": ["string", "null"] },
    "source_worker_job_id": { "type": ["string", "null"] },
    "reasoning_basis_id": { "type": ["string", "null"] },
    "max_output_tokens": { "type": ["integer", "null"], "minimum": 1 },
    "prompt_cache_key": { "type": ["string", "null"], "minLength": 1 }
  },
  "additionalProperties": false,
  "$defs": {
    "input_item": {
      "oneOf": [
        {
          "type": "object",
          "required": ["ToolCall"],
          "properties": {
            "ToolCall": {
              "type": "object",
              "required": ["call_id", "name", "arguments"],
              "properties": {
                "call_id": { "type": "string" },
                "name": { "type": "string" },
                "arguments": { "type": "string" }
              },
              "additionalProperties": false
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": ["UserText"],
          "properties": {
            "UserText": {
              "type": "object",
              "required": ["text"],
              "properties": { "text": { "type": "string" } },
              "additionalProperties": false
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": ["AssistantText"],
          "properties": {
            "AssistantText": {
              "type": "object",
              "required": ["text"],
              "properties": { "text": { "type": "string" } },
              "additionalProperties": false
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": ["ToolResult"],
          "properties": {
            "ToolResult": {
              "type": "object",
              "required": ["call_id", "output"],
              "properties": {
                "call_id": { "type": "string" },
                "output": { "type": "string" }
              },
              "additionalProperties": false
            }
          },
          "additionalProperties": false
        }
      ]
    }
  }
}
